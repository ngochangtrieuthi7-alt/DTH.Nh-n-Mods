    height:150px;
    background:url("itachi.png") center/contain no-repeat;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%) scale(0);
    opacity:0;
    animation: itachiEye 13s infinite;
    animation-delay:10s;
    pointer-events:none;
    z-index:999;
}

@keyframes itachiEye{
    0%, 75%{
        opacity:0;
        transform:translate(-50%,-50%) scale(0);
    }

    80%{
        opacity:1;
        transform:translate(-50%,-50%) scale(1);
    }

    95%{
        opacity:1;
    }

    100%{
        opacity:0;
        transform:translate(-50%,-50%) scale(1.2);
    }
}

